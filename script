 make("UIListLayout",{
  Padding=UDim.new(0,3),
  SortOrder=Enum.SortOrder.LayoutOrder
 },list)

 b.MouseButton1Click:Connect(function()
  list.Visible=not list.Visible
  list.Size=UDim2.fromOffset(240,list.Visible and 90 or 0)

  for _,v in ipairs(list:GetChildren()) do
   if v:IsA("TextButton") then v:Destroy() end
  end

  for i,n in ipairs(getNames()) do
   local item=button(list,"Choice",n,0,0,230,27,Gray,81)
   item.Size=UDim2.new(1,-5,0,27)
   item.LayoutOrder=i

   item.MouseButton1Click:Connect(function()
    if which=="A" then A=n else B=n end
    b.Text=n.." ▼"
    list.Visible=false
    list.Size=UDim2.fromOffset(240,0)
   end)
  end

  list.CanvasSize=UDim2.fromOffset(0,#getNames()*30)
 end)

 return b
end

