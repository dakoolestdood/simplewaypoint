-- Random colors, avoiding consecutive repeats
local Colors = {
    Color3.fromRGB(255, 75, 75),
    Color3.fromRGB(65, 160, 255),
    Color3.fromRGB(80, 230, 130),
    Color3.fromRGB(210, 100, 255),
    Color3.fromRGB(255, 190, 55),
    Color3.fromRGB(50, 220, 210),
    Color3.fromRGB(255, 105, 180),
    Color3.fromRGB(175, 255, 70),
    Color3.fromRGB(255, 135, 55)
}

local function randomColor()
    local available = {}

    for _, color in ipairs(Colors) do
        if color ~= LastColor then
            table.insert(available, color)
        end
    end

    local color = available[math.random(1, #available)]
    LastColor = color
    return color
end

-- Create waypoint cube
local function createMarker(name, position, color)
    local marker = Instance.new("Part")
    marker.Name = "Marker_" .. name
    marker.Size = Vector3.new(1.25, 1.25, 1.25)
    marker.Position = position
    marker.Anchored = true
    marker.CanCollide = false
    marker.CanTouch = false
    marker.CanQuery = false
    marker.CastShadow = false
    marker.Material = Enum.Material.Neon
    marker.Color = color
    marker.Transparency = 0.45
    marker.Parent = MarkerFolder

    return marker
end

local function updateVisibility()
    for name, data in pairs(Waypoints) do
        if data.Marker then
            data.Marker.Transparency =
                (ShowAll or name == Selected) and 0.45 or 1
        end
    end

    Visibility.Text = ShowAll
        and "SHOW ALL: ON"
        or "SHOW ALL: OFF"

    Visibility.BackgroundColor3 = ShowAll and Blue or Gray
end

local function refresh()
    Drop.Text = Selected
        and ("◆ " .. Selected .. " ▼")
        or "No waypoint selected ▼"

    for _, child in ipairs(List:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local names = {}

    for name in pairs(Waypoints) do
        table.insert(names, name)
    end

    table.sort(names)

    for index, name in ipairs(names) do
        local item = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = Color3.fromRGB(45, 55, 73),
            Text = "  " .. name,
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 11,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            BorderSizePixel = 0,
            ZIndex = 51,
            Active = true,
            LayoutOrder = index
        }, List)

        create("UICorner", {
            CornerRadius = UDim.new(0, 5)
        }, item)

        item.MouseButton1Click:Connect(function()
            Selected = name
            List.Visible = false
            List.Size = UDim2.new(1, -24, 0, 0)
            refresh()
            updateVisibility()
        end)
    end

    List.CanvasSize = UDim2.fromOffset(0, #names * 34 + 8)
    updateVisibility()
end

Drop.MouseButton1Click:Connect(function()
