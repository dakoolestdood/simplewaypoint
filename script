 tool.Activated:Connect(function()
  local data=Waypoints[target]
  if not data then
   Status.Text="Waypoint no longer exists!"
   removeTool()
   return
  end

  local hit=Mouse.Hit
  if not hit then
   Status.Text="No position detected!"
   return
  end

  data.CFrame=CFrame.new(hit.Position)
  data.Marker.Position=hit.Position

  Status.Text="Updated "..target.." coordinates!"
  removeTool()
  refresh()
 end)

 Status.Text="Equip the tool and click a position!"
end)

