local function refresh()
    Drop.Text = Selected and ("◆  " .. Selected .. "  ▼")
        or "No waypoint selected  ▼"

    for _, child in ipairs(List:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    for name in pairs(Waypoints) do
        local item = create("TextButton", {
            Size = UDim2.new(1, -8, 0, 30),
            BackgroundColor3 = Color3.fromRGB(45, 55, 73),
            Text = "  " .. name,
            TextColor3 = Color3.new(1, 1, 1),
            TextSize = 11,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left,
            BorderSizePixel = 0
        }, List)

        create("UICorner", {
            CornerRadius = UDim.new(0, 5)
        }, item)

        item.MouseButton1Click:Connect(function()
            Selected = name
            List.Visible = false
            List.Size = UDim2.new(1, -24, 0, 0)
            refresh()
        end)
    end

    List.CanvasSize = UDim2.fromOffset(0,
        #List:GetChildren() * 34)
end

Drop.MouseButton1Click:Connect(function()
    List.Visible = not List.Visible
    List.Size = List.Visible
        and UDim2.new(1, -24, 0, 125)
        or UDim2.new(1, -24, 0, 0)
end)

New.MouseButton1Click:Connect(function()
    local root = getRoot()
    if not root then return end

    local name = NameBox.Text
    if name == "" then
        name = "Waypoint " .. tostring(#(function()
            local t = {}
            for _ in pairs(Waypoints) do
                table.insert(t, true)
            end
            return t
        end)() + 1)
    end

    if Waypoints[name] then
        Status.Text = "Name already exists!"
        return
    end

    Waypoints[name] = root.CFrame
    Selected = name
    NameBox.Text = ""
    refresh()
    Status.Text = "Created: " .. name
end)

Save.MouseButton1Click:Connect(function()
    local root = getRoot()
    if not root or not Selected then
        Status.Text = "Select a waypoint first!"
        return
    end

    Waypoints[Selected] = root.CFrame
    Status.Text = "Coordinates updated!"
end)

Delete.MouseButton1Click:Connect(function()
    if not Selected then return end
    Waypoints[Selected] = nil
    Selected = nil
    refresh()
    Status.Text = "Waypoint deleted"
end)

Rename.MouseButton1Click:Connect(function()
    if not Selected then return end

    local newName = NameBox.Text
    if newName == "" or Waypoints[newName] then
        Status.Text = "Enter a unique name!"
        return
    end

    Waypoints[newName] = Waypoints[Selected]
    Waypoints[Selected] = nil
    Selected = newName
    NameBox.Text = ""
    refresh()
    Status.Text = "Waypoint renamed!"
end)

local function teleport(smooth)
    if not Selected or not Waypoints[Selected] then
        Status.Text = "Select a waypoint first!"
        return
    end

    local root = getRoot()
    if not root then
        Status.Text = "Character unavailable"
        return
    end

    if ActiveTween then
        ActiveTween:Cancel()
        ActiveTween = nil
    end

    if smooth then
        ActiveTween = TweenService:Create(
            root,
            TweenInfo.new(1.5, Enum.EasingStyle.Linear),
            {CFrame = Waypoints[Selected]}
        )
        ActiveTween:Play()
        Status.Text = "Tweening to " .. Selected
    else
        root.CFrame = Waypoints[Selected]
        Status.Text = "Teleported to " .. Selected
    end
end

Tween.MouseButton1Click:Connect(function()
    teleport(true)
end)

TP.MouseButton1Click:Connect(function()
    teleport(false)
end)

Close.MouseButton1Click:Connect(function()
    if ActiveTween then ActiveTween:Cancel() end
    Gui:Destroy()
end)

-- Mobile and mouse dragging
local dragging = false
local dragStart, startPos

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

refresh()
