-- Create new waypoint
New.MouseButton1Click:Connect(function()
    local root = getRoot()

    if not root then
        Status.Text = "Character unavailable"
        return
    end

    local name = NameBox.Text

    if name == "" then
        local count = 0
        for _ in pairs(Waypoints) do
            count = count + 1
        end
        name = "Waypoint " .. (count + 1)
    end

    if Waypoints[name] then
        Status.Text = "Name already exists!"
        return
    end

    local position = root.Position
    local color = randomColor()

    Waypoints[name] = {
        CFrame = root.CFrame,
        Color = color,
        Marker = createMarker(name, position, color)
    }

    Selected = name
    NameBox.Text = ""

    refresh()
    Status.Text = "Created: " .. name
end)

-- Coordinate click tool
local function removeTool()
    if ClickTool then
        ClickTool:Destroy()
        ClickTool = nil
    end
end

GetTool.MouseButton1Click:Connect(function()
    if not Selected then
        Status.Text = "Select a waypoint first!"
        return
    end

    removeTool()

    local backpack = Player:FindFirstChildOfClass("Backpack")
    if not backpack then
        Status.Text = "Backpack unavailable"
        return
    end

    local tool = Instance.new("Tool")
    tool.Name = "Set Waypoint: " .. Selected
    tool.ToolTip = "Click somewhere to set waypoint coordinates"
    tool.RequiresHandle = false
    tool.CanBeDropped = false
    tool.Parent = backpack

    ClickTool = tool

    local targetName = Selected

    tool.Activated:Connect(function()
        if not Waypoints[targetName] then
            Status.Text = "Waypoint no longer exists!"
            removeTool()
            return
        end

        local hit = Mouse.Hit

        if not hit then
            Status.Text = "No position detected!"
            return
        end

        local position = hit.Position

        Waypoints[targetName].CFrame = CFrame.new(position)
        Waypoints[targetName].Marker.Position = position

        Status.Text = "Updated " .. targetName .. " coordinates!"

        removeTool()
        refresh()
    end)

    Status.Text = "Equip the tool and click a position!"
end)

-- Visibility toggle
Visibility.MouseButton1Click:Connect(function()
    ShowAll = not ShowAll
    updateVisibility()
end)

-- Rename waypoint
Rename.MouseButton1Click:Connect(function()
    if not Selected then
        Status.Text = "Select a waypoint first!"
        return
    end

    local newName = NameBox.Text

    if newName == "" or Waypoints[newName] then
        Status.Text = "Enter a unique name!"
        return
    end

    local data = Waypoints[Selected]

    Waypoints[newName] = data
    Waypoints[Selected] = nil

    data.Marker.Name = "Marker_" .. newName

    Selected = newName
    NameBox.Text = ""

    refresh()
    Status.Text = "Waypoint renamed!"
end)

-- Delete waypoint
Delete.MouseButton1Click:Connect(function()
    if not Selected then
        Status.Text = "Select a waypoint first!"
        return
    end

    local data = Waypoints[Selected]

    if data.Marker then
        data.Marker:Destroy()
    end

    Waypoints[Selected] = nil
    Selected = nil

    removeTool()
    refresh()

    Status.Text = "Waypoint deleted"
end)

-- Teleport
local function teleport(smooth)
    if not Selected or not Waypoints[Selected] then
        Status.Text = "Select a waypoint first!"
        return
    end

    local root = getRoot()

    if not root then
        Status.Text = "Character unavailable"
        return
    end

    if ActiveTween then
        ActiveTween:Cancel()
        ActiveTween = nil
    end

    local target = Waypoints[Selected].CFrame

    if smooth then
        ActiveTween = TweenService:Create(
            root,
            TweenInfo.new(1.5, Enum.EasingStyle.Linear),
            {CFrame = target}
        )

        ActiveTween:Play()
        Status.Text = "Tweening to " .. Selected
    else
        root.CFrame = target
        Status.Text = "Teleported to " .. Selected
    end
end

TweenButton.MouseButton1Click:Connect(function()
    teleport(true)
end)

TP.MouseButton1Click:Connect(function()
    teleport(false)
end)

-- Close
Close.MouseButton1Click:Connect(function()
    if ActiveTween then
        ActiveTween:Cancel()
    end

    removeTool()
    MarkerFolder:Destroy()
    Gui:Destroy()
end)

-- Dragging support
local dragging = false
local dragStart
local startPos

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

refresh()
