local function move(smooth)
 local r=root()
 local d=Selected and W[Selected]
 if not r or not d then return end
 if ActiveTween then ActiveTween:Cancel() end
 if smooth then
  ActiveTween=TS:Create(r,TweenInfo.new(Speed,Enum.EasingStyle.Linear),{CFrame=d.cf})
  ActiveTween:Play()
 else
  r.CFrame=d.cf
 end
end

