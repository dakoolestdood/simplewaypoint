-- ROUTE SELECTOR ROWS
local function createRouteRow(index)
 local row=make("Frame",{
  Size=UDim2.new(1,-5,0,35),
  BackgroundTransparency=1,
  LayoutOrder=index
 },RouteScroll)

 local selectButton=button(row,"WaypointSelect",
  "SELECT WAYPOINT ▼",0,0,195,32,Gray,3)

 local deleteButton=button(row,"Remove","×",200,0,35,32,Red,3)

 local menu=make("ScrollingFrame",{
  Position=UDim2.fromOffset(0,34),
  Size=UDim2.fromOffset(195,0),
  BackgroundColor3=Color3.fromRGB(35,42,56),
  BorderSizePixel=0,
  ScrollBarThickness=4,
  Visible=false,
  ZIndex=20,
  Active=true,
  ClipsDescendants=true
 },row)
 corner(menu)

 make("UIListLayout",{
  Padding=UDim.new(0,2)
 },menu)

 local entry={Row=row,Button=selectButton,Menu=menu,Value=nil}
 table.insert(Route,entry)

 local function refreshMenu()
  for _,v in ipairs(menu:GetChildren()) do
   if v:IsA("TextButton") then v:Destroy() end
  end

  for i,n in ipairs(getNames()) do
   local option=button(menu,"Option",n,0,0,185,27,Gray,21)
   option.Size=UDim2.new(1,-4,0,27)
   option.LayoutOrder=i

   option.MouseButton1Click:Connect(function()
    entry.Value=n
    selectButton.Text=n.." ▼"
    menu.Visible=false
    menu.Size=UDim2.fromOffset(195,0)
   end)
  end

  menu.CanvasSize=UDim2.fromOffset(0,#getNames()*29)
 end

 selectButton.MouseButton1Click:Connect(function()
  refreshMenu()
  menu.Visible=not menu.Visible
  menu.Size=UDim2.fromOffset(195,menu.Visible and 100 or 0)
 end)

 deleteButton.MouseButton1Click:Connect(function()
  if Running then stopLoop() end
  for i,v in ipairs(Route) do
   if v==entry then
    table.remove(Route,i)
    break
   end
  end
  row:Destroy()
  for i,v in ipairs(Route) do
   v.Row.LayoutOrder=i
  end
 end)

 return entry
end

local function addRouteRow()
 if #Route>=100 then
