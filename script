 },f)
 return f
end

local function button(parent,name,txt,x,y,w,h,color,z)
 local b=make("TextButton",{
  Name=name,
  Position=UDim2.fromOffset(x,y),
  Size=UDim2.fromOffset(w,h),
  BackgroundColor3=color,
  Text=txt,
  TextColor3=Color3.new(1,1,1),
  TextSize=11,
  Font=Enum.Font.GothamBold,
  BorderSizePixel=0,
  ZIndex=z or 2,
  Active=true
 },parent)
 corner(b)
 return b
end

local function label(parent,txt,x,y,w,h,size,color)
 return make("TextLabel",{
  Position=UDim2.fromOffset(x,y),
  Size=UDim2.fromOffset(w,h),
  BackgroundTransparency=1,
  Text=txt,
  TextColor3=color or Color3.new(1,1,1),
  TextSize=size or 11,
  Font=Enum.Font.GothamBold,
  TextXAlignment=Enum.TextXAlignment.Left
 },parent)
end

local function textbox(parent,x,y,w,h,placeholder,value)
 local t=make("TextBox",{
  Position=UDim2.fromOffset(x,y),
  Size=UDim2.fromOffset(w,h),
  BackgroundColor3=Color3.fromRGB(34,40,54),
  Text=value or "",
  PlaceholderText=placeholder,
  TextColor3=Color3.new(1,1,1),
  TextSize=12,
  Font=Enum.Font.Gotham,
  ClearTextOnFocus=false,
  BorderSizePixel=0
 },parent)
 corner(t)
 return t
end

