-- LOOP
local function startLoop(mode)
 if Running then stopLoop() end

 if #Route<2 then
  Status.Text="Add at least two route slots!"
  return
 end

 local targets={}
 for _,entry in ipairs(Route) do
  if not entry.Value or not Waypoints[entry.Value] then
   Status.Text="Choose a waypoint in every slot!"
   return
  end
  table.insert(targets,entry.Value)
 end

 for i=2,#targets do
  if targets[i]==targets[i-1] then
   Status.Text="Choose different consecutive waypoints!"
   return
  end
 end

 Running=true
 LoopToken=LoopToken+1
 local token=LoopToken

 if mode=="Tween" then
  LoopTween.Text="STOP TWEEN"
  LoopTween.BackgroundColor3=Red
 else
  LoopTP.Text="STOP LOOP TP"
  LoopTP.BackgroundColor3=Red
 end

 task.spawn(function()
  local index=1

  while Running and LoopToken==token do
   local r=root()
   local data=Waypoints[targets[index]]
   if not r or not data then break end

   if mode=="TP" then
    r.CFrame=data.CFrame
    task.wait(Speed)
   else
    local tween=TS:Create(r,
     TweenInfo.new(Speed,Enum.EasingStyle.Linear),
     {CFrame=data.CFrame})

    ActiveTween=tween
    tween:Play()
    local result=tween.Completed:Wait()

    if result~=Enum.PlaybackState.Completed then break end
    ActiveTween=nil
   end

   index=index%#targets+1
  end

  if LoopToken==token then
   stopLoop()
   Status.Text="Loop stopped"
  end
 end)

 Status.Text=mode.." route started"
end

LoopTween.MouseButton1Click:Connect(function()
 if Running then
  stopLoop()
  Status.Text="Loop stopped"
 else
  startLoop("Tween")
 end
end)

LoopTP.MouseButton1Click:Connect(function()
 if Running then
  stopLoop()
  Status.Text="Loop stopped"
 else
  startLoop("TP")
 end
end)

