-- LOOP ENGINE
local function startLoop(mode)
 if Running then stopLoop() end

 if not A or not B or A==B or not Waypoints[A] or not Waypoints[B] then
  Status.Text="Choose two different waypoints!"
  return
 end

 Running=true
 LoopToken=LoopToken+1
 local myToken=LoopToken

 if mode=="Tween" then
  LoopTween.Text="STOP LOOP TWEEN"
  LoopTween.BackgroundColor3=Red
 else
  LoopTP.Text="STOP LOOP TP"
  LoopTP.BackgroundColor3=Red
 end

 Status.Text="Loop "..mode.." started"

 task.spawn(function()
  local destination=B

  while Running and LoopToken==myToken do
   local r=root()
   local data=Waypoints[destination]

   if not r or not data then break end

   local target=data.CFrame

   if mode=="TP" then
    r.CFrame=target
    task.wait(Speed)
   else
    local tween=TS:Create(r,
     TweenInfo.new(Speed,Enum.EasingStyle.Linear),
     {CFrame=target})

    ActiveTween=tween
    tween:Play()

    local result=tween.Completed:Wait()
    if result~=Enum.PlaybackState.Completed then break end
    ActiveTween=nil
   end

   destination=(destination==A) and B or A
  end

  if LoopToken==myToken then
   stopLoop()
   Status.Text="Loop stopped"
  end
 end)
end

LoopTween.MouseButton1Click:Connect(function()
 if Running then
  stopLoop()
  Status.Text="Loop stopped"
 else
  startLoop("Tween")
 end
end)

LoopTP.MouseButton1Click:Connect(function()
 if Running then
  stopLoop()
  Status.Text="Loop stopped"
 else
