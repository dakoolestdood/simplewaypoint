local function getNames()
 local names={}
 for n in pairs(Waypoints) do
  table.insert(names,n)
 end
 table.sort(names)
 return names
end

local function selector(which,y)
 local b=button(Panel,"Select"..which,
  "SELECT "..which.." ▼",10,y,240,32,Gray,5)

 local list=make("ScrollingFrame",{
  Position=UDim2.fromOffset(10,y+34),
  Size=UDim2.fromOffset(240,0),
  BackgroundColor3=Color3.fromRGB(29,34,46),
