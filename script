local function addWaypoint(name,pos,cf)
 if W[name] then return false end
 local c=color()
 W[name]={
  pos=pos,cf=cf or CFrame.new(pos),
  marker=marker(pos,c)
 }
 Selected=name
 refresh()
 return true
end

