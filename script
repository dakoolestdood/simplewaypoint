local function stopLoop()
 Running=false
 Token=Token+1
 if ActiveTween then
  ActiveTween:Cancel()
  ActiveTween=nil
 end
 TweenLoop.Text="LOOP TWEEN: OFF"
 TPLoop.Text="LOOP TP: OFF"
 TweenLoop.BackgroundColor3=Color3.fromRGB(40,115,210)
 TPLoop.BackgroundColor3=Color3.fromRGB(35,145,105)
end

local function startLoop(mode)
 if Running then stopLoop() end
 if not A or not B or A==B or not W[A] or not W[B] then
  Status.Text="Select two different waypoints!"
  return
 end

 Running=true
 Token=Token+1
 local myToken=Token

 if mode=="Tween" then
  TweenLoop.Text="STOP LOOP TWEEN"
  TweenLoop.BackgroundColor3=Color3.fromRGB(170,65,75)
 else
  TPLoop.Text="STOP LOOP TP"
  TPLoop.BackgroundColor3=Color3.fromRGB(170,65,75)
 end

 task.spawn(function()
  local destination=B

  while Running and Token==myToken do
   local r=root()
   local data=W[destination]
   if not r or not data then break end

   local duration=Speed

   if mode=="TP" then
    -- Client-side teleport is only suitable for authorized testing.
    r.CFrame=data.cf
    task.wait(duration)
   else
    local tween=TS:Create(r,
     TweenInfo.new(duration,Enum.EasingStyle.Linear),
     {CFrame=data.cf})
    ActiveTween=tween
    tween:Play()

    local state=tween.Completed:Wait()
    if state~=Enum.PlaybackState.Completed then break end
    ActiveTween=nil
   end

   destination=(destination==A) and B or A
  end

  if Token==myToken then stopLoop() end
 end)
end

