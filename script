local function randomColor()
 local t={}
 for _,c in ipairs(Colors) do
  if c~=LastColor then table.insert(t,c) end
 end
 LastColor=t[math.random(1,#t)]
 return LastColor
end

local function createMarker(name,pos,color)
 return make("Part",{
  Name="Marker_"..name,
  Size=Vector3.new(1.25,1.25,1.25),
  Position=pos,
  Anchored=true,
  CanCollide=false,
  CanTouch=false,
  CanQuery=false,
  CastShadow=false,
  Material=Enum.Material.Neon,
  Color=color,
  Transparency=.45
 },Folder)
end

local function updateVisibility()
 for n,d in pairs(Waypoints) do
  if d.Marker then
   d.Marker.Transparency=(ShowAll or n==Selected) and .45 or 1
  end
 end
 Visibility.Text=ShowAll and "SHOW ALL: ON" or "SHOW ALL: OFF"
 Visibility.BackgroundColor3=ShowAll and Blue or Gray
end

local function refresh()
 Drop.Text=Selected and ("◆ "..Selected.." ▼")
  or "No waypoint selected ▼"

 for _,v in ipairs(List:GetChildren()) do
  if v:IsA("TextButton") then v:Destroy() end
 end

 for i,n in ipairs(getNames()) do
  local item=button(List,"Waypoint",n,0,0,240,30,Gray,51)
  item.Size=UDim2.new(1,-5,0,30)
  item.LayoutOrder=i

  item.MouseButton1Click:Connect(function()
   Selected=n
   List.Visible=false
   List.Size=UDim2.new(1,-24,0,0)
   refresh()
  end)
 end

 List.CanvasSize=UDim2.fromOffset(0,#getNames()*34+8)
 updateVisibility()
end

local function removeTool()
 if ClickTool then
  ClickTool:Destroy()
  ClickTool=nil
 end
end

local function stopLoop()
 Running=false
 LoopToken=LoopToken+1

 if ActiveTween then
  ActiveTween:Cancel()
  ActiveTween=nil
 end

 LoopTween.Text="LOOP TWEEN: OFF"
 LoopTP.Text="LOOP TP: OFF"
 LoopTween.BackgroundColor3=Blue
 LoopTP.BackgroundColor3=Green
end

local function cancelIfMissing(name)
 if A==name then A=nil end
 if B==name then B=nil end
 if Running and (A==nil or B==nil) then
  stopLoop()
 end
end

