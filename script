local function randomColor()
 local t={}
 for _,c in ipairs(Colors) do
  if c~=LastColor then table.insert(t,c) end
 end
 LastColor=t[math.random(1,#t)]
 return LastColor
end

local function createMarker(name,pos,color)
 return make("Part",{
  Name="Marker_"..name,
  Size=Vector3.new(1.25,1.25,1.25),
  Position=pos,
  Anchored=true,
  CanCollide=false,
  CanTouch=false,
  CanQuery=false,
  CastShadow=false,
  Material=Enum.Material.Neon,
  Color=color,
  Transparency=.45
 },Folder)
end

local function getNames()
 local t={}
 for n in pairs(Waypoints) do table.insert(t,n) end
 table.sort(t)
 return t
end

local function updateVisibility()
